# Neon — projet reserve-market (région AWS Europe Frankfurt)
# Copier ce fichier en .env, puis coller les deux chaînes de connexion
# (console Neon → Connect). Le fichier .env n'est jamais commité.
# Dans les deux URL, remplacer sslmode=require par sslmode=verify-full :
# pg traite déjà require comme verify-full, mais changera en v9 pour un mode moins sûr.
# https://www.postgresql.org/docs/current/libpq-ssl.html

# Connexion poolée (l'hôte contient "-pooler") : application et seed.
DATABASE_URL="postgresql://..."

# Connexion directe (sans "-pooler") : CLI Prisma (migrations).
DATABASE_URL_UNPOOLED="postgresql://..."

# Serveur
NODE_ENV=development
PORT=3001
# Secret de signature des jetons de session, au moins 32 caractères aléatoires. Pour en générer un :
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Nombre de proxys devant l'application : 0 en local, 1 sur Render.
# https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY_HOPS=0

# Cloudinary : tableau de bord Cloudinary → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Compte administrateur créé par npm run db:seed (8 caractères minimum, dont une majuscule et un chiffre)
SEED_ADMIN_NOM="Administrateur"
SEED_ADMIN_EMAIL=
SEED_ADMIN_MOT_DE_PASSE=
