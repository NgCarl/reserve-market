# Copier en .env (ignoré par git). Lu par {{$dotenv NOM}} dans requests.rest.

# Mêmes valeurs que SEED_ADMIN_EMAIL et SEED_ADMIN_MOT_DE_PASSE de backend/.env
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=

# Compte créé par la requête « Création d'un compte » (8 caractères minimum, dont une majuscule et un chiffre)
SERVEUR_EMAIL=serveur.test@reserve-market.local
SERVEUR_MOT_DE_PASSE=
