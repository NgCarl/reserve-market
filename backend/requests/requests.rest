# Prérequis : npm run dev dans backend/. Identifiants lus dans requests/.env.

@baseUrl = http://localhost:3001/api

### Menu d'une table (public, sans connexion)
# @name menu
GET {{baseUrl}}/menu/{{$dotenv TABLE_JETON}}

### Passer une commande (client) : 201, puis 200 si la même clé est renvoyée
# @name commande
POST {{baseUrl}}/menu/{{$dotenv TABLE_JETON}}/commandes
Content-Type: application/json

{
  "cleIdempotence": "{{$guid}}",
  "chaise": 1,
  "lignes": [
    { "platId": {{menu.response.body.$.categories[0].plats[0].id}}, "quantite": 1, "note": "Bien cuite" }
  ]
}

### Suivi de la commande (client)
GET {{baseUrl}}/menu/{{$dotenv TABLE_JETON}}/commandes/{{commande.response.body.$.commande.id}}

### Commandes de la table pendant le service (client)
GET {{baseUrl}}/menu/{{$dotenv TABLE_JETON}}/commandes

### Connexion admin

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "motDePasse": "{{$dotenv ADMIN_MOT_DE_PASSE}}"
}

### Session courante
GET {{baseUrl}}/auth/check-auth

### Écran cuisine : commandes en cours (compte CUISINE ou ADMIN)
GET {{baseUrl}}/cuisine/commandes

### Cuisine : commencer la préparation (commande passée plus haut)
PATCH {{baseUrl}}/cuisine/lignes/statut
Content-Type: application/json

{
  "ligneIds": [{{commande.response.body.$.commande.lignes[0].id}}],
  "statut": "EN_PREPARATION"
}

### Cuisine : marquer urgente
PATCH {{baseUrl}}/cuisine/commandes/urgence
Content-Type: application/json

{
  "commandeIds": [{{commande.response.body.$.commande.id}}],
  "urgent": true
}

### Cuisine : annuler un article avec son motif
POST {{baseUrl}}/cuisine/lignes/{{commande.response.body.$.commande.lignes[0].id}}/annulation
Content-Type: application/json

{
  "motif": "Rupture de stock"
}

### Liste du personnel (admin)
GET {{baseUrl}}/utilisateurs

### Création d'un compte (admin)

POST {{baseUrl}}/utilisateurs
Content-Type: application/json

{
  "nom": "Serveur de test",
  "email": "{{$dotenv SERVEUR_EMAIL}}",
  "motDePasse": "{{$dotenv SERVEUR_MOT_DE_PASSE}}",
  "role": "SERVEUR"
}

### Inscription d'un cuisinier (publique : le compte est créé inactif)
POST {{baseUrl}}/auth/inscription
Content-Type: application/json

{
  "nom": "Cuisinier de test",
  "email": "{{$dotenv CUISINE_EMAIL}}",
  "motDePasse": "{{$dotenv CUISINE_MOT_DE_PASSE}}",
  "role": "CUISINE"
}

### Activer un compte ou changer son rôle (admin)
# @prompt utilisateurId Id du compte, visible dans la liste du personnel
PATCH {{baseUrl}}/utilisateurs/{{utilisateurId}}
Content-Type: application/json

{
  "actif": true
}

### Connexion avec un mauvais mot de passe (3 échecs : suspension 15 min)

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "motDePasse": "Mauvais123"
}

### Catégories (admin)
GET {{baseUrl}}/categories

### Création d'une catégorie
# @name categorie
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "nom": "Desserts",
  "poste": "CUISINE"
}

### Plats (admin)
GET {{baseUrl}}/plats

### Création d'un plat avec tailles et extras
# @name plat
POST {{baseUrl}}/plats
Content-Type: application/json

{
  "categorieId": {{categorie.response.body.$.categorie.id}},
  "nom": "Salade de fruits",
  "prix": 1500,
  "tempsPreparationMin": 5,
  "groupesVariantes": [
    { "nom": "Taille", "options": [{ "nom": "Petit", "supplement": 0 }, { "nom": "Grand", "supplement": 1000 }] }
  ],
  "extras": [{ "nom": "Chantilly", "prix": 300 }]
}

### Modification d'un plat (prix, épuisé)
PATCH {{baseUrl}}/plats/{{plat.response.body.$.plat.id}}
Content-Type: application/json

{
  "prix": 2000,
  "disponible": false
}

### Signature pour envoyer une photo à Cloudinary
POST {{baseUrl}}/plats/photo/signature

### Archivage du plat
DELETE {{baseUrl}}/plats/{{plat.response.body.$.plat.id}}

### Archivage de la catégorie
DELETE {{baseUrl}}/categories/{{categorie.response.body.$.categorie.id}}

### Déconnexion
POST {{baseUrl}}/auth/logout
